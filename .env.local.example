# Copiez ce fichier en `.env.local` pour le développement local
# et ajoutez ces mêmes variables dans Vercel -> Project Settings -> Environment Variables

# URL de votre projet Supabase (Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co

# Clé publique Supabase (Settings -> API -> Project API keys -> anon / publishable key)
# NE JAMAIS utiliser la clé service_role ici !
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-publique-anon-ou-publishable

# URL publique de votre application Vercel (sans slash à la fin)
# Utilisée dans le panneau admin pour générer les liens de partage
NEXT_PUBLIC_SITE_URL=https://dl.monsite.ma

# (Optionnel) URL de votre blog Blogger principal pour le lien de retour
NEXT_PUBLIC_BLOG_URL=https://www.monsite.ma

# (Optionnel - Prof IA ExamQuiz) Clé API gratuite Google Gemini (https://aistudio.google.com/apikey)
# NE JAMAIS préfixer par NEXT_PUBLIC_ (reste strictement côté serveur)
GEMINI_API_KEY=votre-cle-google-gemini-api
